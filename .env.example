# Copy to .env (git-ignored). Base URL of the Coparent backend.
# Leave empty in development to use http://localhost:8080 (iOS simulator) / http://10.0.2.2:8080 (Android emulator).
API_URL=

# Domain of the https links opened by the app (Universal Links / App Links), e.g. coparent.fr.
# Empty: only coparent://invitation?token=… links open the app.
APP_LINKS_DOMAIN=
