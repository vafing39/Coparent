<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Universal Links : liens https d'invitation ouverts dans l'app.
		À remplacer par le domaine réel (même valeur que APP_LINKS_DOMAIN dans .env),
		qui doit servir /.well-known/apple-app-site-association (backend, app.links.*).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:example.invalid</string>
	</array>
</dict>
</plist>
